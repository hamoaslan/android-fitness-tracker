<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:columnCount="1"
    android:rowCount="11">
    <TextView
        android:layout_column="0"
        android:layout_row="0"
        android:text="@string/food"
        android:textColor="@android:color/holo_blue_light"
        android:textStyle="bold"
        android:textSize="40sp"
        android:layout_gravity="center_horizontal">
    </TextView>
    <Button
        android:id="@+id/btn_food"
        android:layout_column="0"
        android:layout_row="1"
        android:layout_gravity="center_horizontal"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:backgroundTint="@android:color/darker_gray"
        android:text="@string/scan"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@android:color/black">
    </Button>
    <TextView
        android:id="@+id/tmp"
        android:layout_column="0"
        android:layout_row="2"
        android:textColor="@android:color/holo_blue_light"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center_horizontal">
    </TextView>
    <ProgressBar android:id="@+id/calories_bar"
        android:layout_column="0"
        android:layout_row="3"
        android:layout_gravity="center_horizontal"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:progressDrawable="@android:drawable/progress_horizontal"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:id="@+id/calories_bar_txt"
        android:layout_column="0"
        android:layout_row="4"
        android:textColor="@android:color/holo_blue_light"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center_horizontal">
    </TextView>
    <ProgressBar android:id="@+id/protein_bar"
        android:layout_column="0"
        android:layout_row="5"
        android:layout_gravity="center_horizontal"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:progressDrawable="@android:drawable/progress_horizontal"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:id="@+id/protein_bar_txt"
        android:layout_column="0"
        android:layout_row="6"
        android:textColor="@android:color/holo_blue_light"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center_horizontal">
    </TextView>
    <ProgressBar android:id="@+id/fat_bar"
        android:layout_column="0"
        android:layout_row="7"
        android:layout_gravity="center_horizontal"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:progressDrawable="@android:drawable/progress_horizontal"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:id="@+id/fat_bar_txt"
        android:layout_column="0"
        android:layout_row="8"
        android:textColor="@android:color/holo_blue_light"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center_horizontal">
    </TextView>
    <ProgressBar android:id="@+id/carbohydrates_bar"
        android:layout_column="0"
        android:layout_row="9"
        android:layout_gravity="center_horizontal"
        android:layout_width="200dp"
        android:layout_height="60dp"
        android:progressDrawable="@android:drawable/progress_horizontal"
        style="?android:attr/progressBarStyleHorizontal"/>
    <TextView
        android:id="@+id/carbohydrates_bar_txt"
        android:layout_column="0"
        android:layout_row="10"
        android:textColor="@android:color/holo_blue_light"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_gravity="center_horizontal">
    </TextView>
</GridLayout>